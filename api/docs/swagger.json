        "rest.errCode": {
            "type": "integer",
            "enum": [
                0,
                -10,
                -11,
                -20,
                -21,
                -30,
                -40,
                -50,
                -60
            ],
            "x-enum-comments": {
                "_errCodeBadRequest": "for http 400",
                "_errCodeConflict": "for http 409",
                "_errCodeForbidden": "for http 403",
                "_errCodeInternalErr": "for http 500",
                "_errCodeNoError": "Success code.",
                "_errCodeNotFound": "for http 404",
                "_errCodeUnauthorized": "for http 401",
                "_errCodeUnavailable": "for http 503",
                "_errCodeValidation": "for http 422"
            },
            "x-enum-descriptions": [
                "Success code.",
                "for http 422",
                "for http 400",
                "for http 401",
                "for http 403",
                "for http 404",
                "for http 409",
                "for http 500",
                "for http 503"
            ],
            "x-enum-varnames": [
