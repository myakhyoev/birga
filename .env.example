ENVIRONMENT=development
LOG_LEVEL=debug
HTTP_PORT=:8080
METRICS_PORT=:9090

# Shared key for /v1/admin/* (header X-Admin-Key). Leave empty to disable the admin API.
ADMIN_API_KEY=change-me

POSTGRES_URL=postgres://birga:birga@localhost:5432/birga?sslmode=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=5m

# One-time codes and their rate limits live here.
REDIS_URL=redis://localhost:6379/0

# SMS driver: "log" writes SMS (and OTP codes) to the log, "playmobile" sends them.
SMS_PROVIDER=log
PLAYMOBILE_BASE_URL=https://send.smsxabar.uz
# Credentials and originator (sender id) come from the Play Mobile contract. Never commit real values.
PLAYMOBILE_USERNAME=
PLAYMOBILE_PASSWORD=
PLAYMOBILE_ORIGINATOR=3700
PLAYMOBILE_TIMEOUT=10s

OTP_TTL=2m
OTP_RESEND_COOLDOWN=1m
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_IP_HOUR=20
OTP_MAX_VERIFY_ATTEMPTS=5
# How long a verified sign_up code lets the phone number sign up.
OTP_VERIFIED_TTL=10m

# Signs the access and refresh tokens (HS256), at least 32 bytes. This value is for local
# development only; on servers generate one with `openssl rand -hex 32` and keep it secret.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
JWT_ISSUER=birga
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Uploaded media (profile photos) go to this S3 bucket. Empty S3_BUCKET disables POST /v1/media.
S3_BUCKET=
S3_REGION=eu-central-1
# Leave both keys empty to use the AWS default credentials (AWS_* variables, ~/.aws, an IAM role).
# Never commit real values.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3-compatible endpoint such as MinIO (http://localhost:9000); empty means AWS.
S3_ENDPOINT=
# Prefix of returned URLs, e.g. a CloudFront domain; empty means the bucket's own URL.
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=
S3_TIMEOUT=30s
# Largest upload in bytes (5 MiB).
MEDIA_MAX_SIZE=5242880
